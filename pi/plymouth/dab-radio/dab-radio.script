# The animation, in seconds from the first picture.
fade_in = 0.5;       # dots and axes appear
lock_start = 0.8;    # the dots begin to gather
lock_time = 1.6;     # and are in their points this much later
title_start = 1.6;   # the name appears
title_time = 0.8;    # within this
quarter_turns = 3;   # the ring turns this far until the dots are locked
drift = 2.0;         # how far a locked dot drifts about its place (px)
frames_per_second = 50;
pi = 3.14159265358979;

# The ring turns at this speed until the lock begins and comes to rest with it, a whole
# number of quarter turns on, so that the points end on the diagonals: the turn at the
# time t of the lock is the integral of spin * (1 - lock) over the time.
spin = quarter_turns * pi / 2 / (lock_start + lock_time / 2);
rest_turn = spin * (lock_start + lock_time / 2);

Window.SetBackgroundTopColor(design.background_red, design.background_green, design.background_blue);
Window.SetBackgroundBottomColor(design.background_red, design.background_green, design.background_blue);

original_dot = Image("dot.png");
original_axes = Image("axes.png");
original_title = Image("title.png");

axes_sprite = Sprite();
axes_sprite.SetZ(0);
axes_sprite.SetOpacity(0);
title_sprite = Sprite();
title_sprite.SetZ(20);
title_sprite.SetOpacity(0);
# A loop variable of its own: a function assigning to a name that exists globally
# assigns to the global one.
index = 0;
while (index < dots.count)
{
    dot_sprite[index] = Sprite();
    dot_sprite[index].SetZ(10);
    dot_sprite[index].SetOpacity(0);
    index = index + 1;
}

screen_width = 0;
screen_height = 0;
frame = 0;
locked_from_start = Plymouth.GetMode() != "boot";

fun scaled(image)
{
    if (scale == 1)
    {
        return image;
    }
    return image.Scale(Math.Int(image.GetWidth() * scale + 0.5), Math.Int(image.GetHeight() * scale + 0.5));
}

# Lays the picture out on the screen, scaled by the smaller of the two ratios to the
# 1280 x 720 it is drawn for, in the middle.
fun layout()
{
    global.screen_width = Window.GetWidth();
    global.screen_height = Window.GetHeight();
    global.scale = Math.Min(screen_width / design.width, screen_height / design.height);
    global.centre_x = Window.GetX() + screen_width / 2;
    global.centre_y = Window.GetY() + screen_height / 2 + (design.centre_y - design.height / 2) * scale;
    global.dot_half = design.dot_size * scale / 2;

    axes = scaled(original_axes);
    axes_sprite.SetImage(axes);
    axes_sprite.SetX(centre_x - design.axis_length * scale);
    axes_sprite.SetY(centre_y - design.axis_length * scale);

    title = scaled(original_title);
    title_sprite.SetImage(title);
    title_sprite.SetX(centre_x - title.GetWidth() / 2);
    title_sprite.SetY(centre_y + (design.title_centre_y - design.centre_y) * scale - title.GetHeight() / 2);

    dot = scaled(original_dot);
    i = 0;
    while (i < dots.count)
    {
        dot_sprite[i].SetImage(dot);
        i = i + 1;
    }
}

fun smooth(u)
{
    u = Math.Min(Math.Max(u, 0), 1);
    return u * u * (3 - 2 * u);
}

fun refresh()
{
    if (Window.GetWidth() > 0 && Window.GetHeight() > 0)
    {
        if (Window.GetWidth() != screen_width || Window.GetHeight() != screen_height)
        {
            layout();
        }
        t = frame / frames_per_second;
        global.frame = frame + 1;
        if (locked_from_start)
        {
            t = t + 100;
        }

        fade = smooth(t / fade_in);
        u = Math.Min(Math.Max((t - lock_start) / lock_time, 0), 1);
        lock = u * u * (3 - 2 * u);
        if (t < lock_start)
        {
            turn = spin * t;
        }
        else
        {
            turn = spin * (lock_start + lock_time * (u - u * u * u + u * u * u * u / 2));
        }
        turn = turn - rest_turn;
        unlocked = 1 - lock;
        wobble = drift * lock;
        opacity = fade * (0.55 + 0.45 * lock);

        i = 0;
        while (i < dots.count)
        {
            angle = dots.angle[i] + unlocked * dots.spread[i] + turn;
            radius = dots.radius[i] * (1 + unlocked * dots.noise[i]);
            x = radius * Math.Cos(angle) + wobble * Math.Sin(1.4 * pi * t + dots.phase[i]);
            y = radius * Math.Sin(angle) + wobble * Math.Cos(1.8 * pi * t + 1.7 * dots.phase[i]);
            dot_sprite[i].SetX(centre_x + x * scale - dot_half);
            dot_sprite[i].SetY(centre_y + y * scale - dot_half);
            dot_sprite[i].SetOpacity(opacity);
            i = i + 1;
        }
        axes_sprite.SetOpacity(fade);
        title_sprite.SetOpacity(smooth((t - title_start) / title_time));
    }
}

Plymouth.SetRefreshFunction(refresh);
