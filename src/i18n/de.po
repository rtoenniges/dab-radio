#: src/audio/aac.py
msgid ""
"FAAD2 (libfaad2) was not found - without this library the DAB+ audio "
"cannot be decoded. On Debian/Ubuntu: 'apt install libfaad2', on Windows: "
"put faad.dll into the folder .venv\\Scripts."
msgstr ""
"FAAD2 (libfaad2) wurde nicht gefunden - ohne diese Bibliothek lässt sich "
"der DAB+-Ton nicht decodieren. Unter Debian/Ubuntu: 'apt install "
"libfaad2', unter Windows: faad.dll in den Ordner .venv\\Scripts legen."

#: src/audio/aac.py
msgid "Could not initialise FAAD2 (NeAACDecOpen)."
msgstr "FAAD2 konnte nicht initialisiert werden (NeAACDecOpen)."

#: src/audio/aac.py
msgid "FAAD2 rejected the decoder configuration."
msgstr "FAAD2 hat die Decoder-Konfiguration abgelehnt."

#: src/audio/aac.py
#, python-brace-format
msgid "FAAD2 rejects the AudioSpecificConfig {config} (format: {format})."
msgstr "FAAD2 lehnt die AudioSpecificConfig {config} ab (Format: {format})."

#: src/audio/aac.py src/audio/mp2.py
msgid "The decoder has already been closed."
msgstr "Der Decoder wurde bereits geschlossen."

#: src/audio/bluetooth_route.py
#, python-brace-format
msgid "Moving the audio to “{name}” …"
msgstr "Ton geht zu „{name}“ …"

#: src/audio/mp2.py
msgid ""
"libmpg123 was not found - without this library the audio of classic DAB "
"stations cannot be decoded. On Debian/Ubuntu: 'apt install libmpg123-0', "
"on Windows: put libmpg123-0.dll into the folder .venv\\Scripts."
msgstr ""
"libmpg123 wurde nicht gefunden - ohne diese Bibliothek lässt sich der Ton"
" klassischer DAB-Sender nicht decodieren. Unter Debian/Ubuntu: 'apt "
"install libmpg123-0', unter Windows: libmpg123-0.dll in den Ordner "
".venv\\Scripts legen."

#: src/audio/mp2.py
#, python-brace-format
msgid "Could not initialise libmpg123 ({code})."
msgstr "libmpg123 konnte nicht initialisiert werden ({code})."

#: src/audio/mp2.py
#, python-brace-format
msgid "libmpg123 rejects the configuration: {error}"
msgstr "libmpg123 lehnt die Konfiguration ab: {error}"

